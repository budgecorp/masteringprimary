---
import { SITE_TITLE } from '../consts';
---

<header>
	<a href="/" class="title">{SITE_TITLE}</a>
	<nav>
		<a href="/">Home</a>
		<a href="/archive">Archive</a>
		<a href="/about">About</a>
	</nav>
</header>

<style>
	header {
		width: 640px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 2rem 1rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.title {
		font-size: 1.25rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--ink);
		letter-spacing: -0.01em;
	}
	nav {
		display: flex;
		gap: 1.5rem;
		font-size: 0.95rem;
		color: var(--ink-muted);
	}
	nav a {
		color: var(--ink-muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
